---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMentionsLegales } from '../lib/content';
import { renderMarkdown } from '../lib/markdown';

// Legal minimum for a French site (LCEN: publisher, publication director,
// host) plus the GDPR notice required by the newsletter signup. Edited in the
// CMS (Réglages → Mentions légales et confidentialité).
const { titre, texte } = await getMentionsLegales();
const html = await renderMarkdown(texte);
---
<BaseLayout
  title={titre}
  description="Éditeur, hébergeur et traitement des données personnelles du site Théories de la Psychothérapie Institutionnelle."
>
  <section class="py-section">
    <h1 class="mb-section text-title">{titre}</h1>
    <div
      class="max-w-text font-serif text-body [&_a]:underline [&_h2]:mt-section [&_h2]:mb-gutter [&_h2]:font-sans [&_h2]:text-subhead [&_h2:first-child]:mt-0 [&_p+p]:mt-card"
      set:html={html}
    />
  </section>
</BaseLayout>
