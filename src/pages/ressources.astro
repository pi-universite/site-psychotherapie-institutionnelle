---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRessources } from '../lib/content';

const { items, categories } = await getRessources();

// Lower-cased, accent-free text matched by the search box.
const normalize = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
const searchText = (r: (typeof items)[number]) =>
  normalize([r.data.titre, r.data.auteur, r.data.editeur, r.data.annee, r.data.format].filter(Boolean).join(' '));

// Figma: four columns of the agenda grid, the last one split into year and type.
// Vertical rules sit on the left edge of every column but the first.
const columns = [
  { key: 'auteur', label: 'Auteur(s)', width: 'md:w-1/4' },
  { key: 'editeur', label: 'Éditeur', width: 'md:w-1/4' },
  { key: 'annee', label: 'Année', width: 'md:w-[15.5%]' },
  { key: 'format', label: 'Type', width: '' },
] as const;
const ruled = 'md:border-l md:border-encre md:pl-gutter';
---
<BaseLayout
  title="Ressources"
  description="Documents, vidéos et podcasts sur l’histoire et l’actualité de la recherche en psychothérapie institutionnelle."
>
  <section class="py-section">
    <div class="flex flex-wrap items-center justify-between gap-gutter">
      <div class="flex flex-wrap items-baseline gap-x-2 text-small uppercase">
        <h1>Ressources<span class="hidden [.js_&]:inline"> :</span></h1>
        <!-- Filters and search need JavaScript; without it the full table shows. -->
        <ul id="filtres" class="hidden min-w-0 flex-wrap gap-x-1 [.js_&]:flex" aria-label="Filtrer par catégorie">
          <li>
            <a href="#toutes" data-filtre="toutes" class="hover:underline aria-[current=true]:font-bold">
              Toutes ({items.length})
            </a>
          </li>
          {
            categories.map((c) => (
              <li>
                <span aria-hidden="true">/ </span>
                <a href={`#${c.categorie}`} data-filtre={c.categorie} class="hover:underline aria-[current=true]:font-bold">
                  {c.label} ({c.count})
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <input
        id="recherche"
        type="search"
        placeholder="Rechercher…"
        aria-label="Rechercher une ressource"
        class="hidden w-56 rounded-full border border-encre bg-transparent px-gutter py-card text-small placeholder:text-encre/45 [.js_&]:block"
      />
    </div>

    {
      items.length === 0 ? (
        <p class="mt-section font-serif text-body">Aucune ressource pour le moment.</p>
      ) : (
        <table class="mt-gutter w-full border-collapse border-t border-encre text-left">
          <thead class="max-md:sr-only">
            <tr class="text-small uppercase">
              <th scope="col" class="pt-gutter pb-section pr-gutter font-normal md:w-1/4">Titre du document</th>
              {columns.map((c) => (
                <th scope="col" class:list={['pt-gutter pb-section font-normal', c.width, ruled]}>
                  {c.label}
                </th>
              ))}
            </tr>
          </thead>
          <tbody id="ressources-liste" class="font-serif text-body">
            {items.map((r) => (
              <tr
                data-categorie={r.data.categorie}
                data-texte={searchText(r)}
                class="align-top max-md:block max-md:border-b max-md:border-encre/30 max-md:py-card max-md:[&:nth-last-child(1_of_:not([hidden]))]:border-b-0"
              >
                <td class="italic max-md:mb-card max-md:block max-md:text-lead md:py-card md:pr-gutter">
                  {r.data.url ? (
                    <a href={r.data.url} class="underline-offset-4 hover:underline" target="_blank" rel="noopener noreferrer">
                      {r.data.titre}
                    </a>
                  ) : (
                    r.data.titre
                  )}
                </td>
                {columns.map((c) => {
                  const value = r.data[c.key];
                  return (
                    // Phones: one line per filled field, labelled.
                    <td class:list={['max-md:text-small md:py-card', ruled, value ? 'max-md:block' : 'max-md:hidden']}>
                      <span class="label font-normal md:hidden">{c.label} : </span>
                      {value ?? '/'}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
    <p id="aucun-resultat" class="mt-section font-serif text-body" hidden>Aucune ressource ne correspond à cette recherche.</p>
  </section>
</BaseLayout>

<script is:inline>
  // Category filter (from the URL hash, so links like /ressources/#podcast
  // work) combined with a text search over title, author, publisher, year and type.
  (() => {
    const links = document.querySelectorAll('#filtres [data-filtre]');
    const rows = [...document.querySelectorAll('#ressources-liste tr')];
    const input = document.getElementById('recherche');
    const empty = document.getElementById('aucun-resultat');
    const known = new Set([...links].map((l) => l.dataset.filtre));
    const normalize = (s) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
    const apply = () => {
      const hash = location.hash.slice(1);
      const filtre = known.has(hash) ? hash : 'toutes';
      const words = normalize(input.value).split(/\s+/).filter(Boolean);
      let shown = 0;
      rows.forEach((row) => {
        const visible =
          (filtre === 'toutes' || row.dataset.categorie === filtre) &&
          words.every((w) => row.dataset.texte.includes(w));
        row.hidden = !visible;
        if (visible) shown++;
      });
      links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.filtre === filtre)));
      empty.hidden = shown > 0 || rows.length === 0;
    };
    window.addEventListener('hashchange', apply);
    input.addEventListener('input', apply);
    apply();
  })();
</script>
