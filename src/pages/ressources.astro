---
import BaseLayout from '../layouts/BaseLayout.astro';
import Item from '../components/RessourceItem.astro';
import { getRessourcesParCategorie, type Ressource } from '../lib/content';

const categories = await getRessourcesParCategorie();

// Texts are listed under author headings; other categories are flat lists.
function groupByAuthor(items: Ressource[]) {
  const groups = new Map<string, Ressource[]>();
  for (const item of items) {
    const key = item.data.auteur ?? 'Divers';
    groups.set(key, [...(groups.get(key) ?? []), item]);
  }
  return [...groups.entries()];
}
---
<BaseLayout
  title="Ressources"
  description="Textes, podcasts, films et ressources partenaires sur l’histoire et l’actualité de la recherche en psychothérapie institutionnelle."
>
  <section class="py-section">
    <h1 class="text-display font-medium">Ressources</h1>
    <p class="mt-gutter max-w-text font-serif text-body">
      Textes, podcasts, films et ressources partenaires sur l'histoire et l'actualité de la recherche en psychothérapie
      institutionnelle. Cette page s'enrichit au fil des contributions.
    </p>
    <nav aria-label="Catégories de ressources" class="mt-section">
      <ul class="flex flex-wrap gap-card" id="filtres">
        <li>
          <a href="#toutes" data-filtre="toutes" class="label inline-block border border-encre p-card hover:bg-encre hover:text-fond aria-[current=true]:bg-encre aria-[current=true]:text-fond">
            Tout
          </a>
        </li>
        {
          categories.map((c) => (
            <li>
              <a href={`#${c.anchor}`} data-filtre={c.anchor} class="label inline-block border border-encre p-card hover:bg-encre hover:text-fond aria-[current=true]:bg-encre aria-[current=true]:text-fond">
                {c.label} <span class="font-normal">({c.items.length})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>

  <div id="toutes">
    {
      categories.map((c) => (
        <section id={c.anchor} data-categorie={c.anchor} class="border-t border-encre py-section md:grid md:grid-cols-3 md:gap-x-gutter">
          <h2 class="mb-section text-title">{c.label}</h2>
          {c.items.length === 0 ? (
            <p class="font-serif text-body md:col-span-2">Aucune ressource pour le moment.</p>
          ) : c.categorie === 'textes' ? (
            <div class="space-y-section md:col-span-2">
              {groupByAuthor(c.items).map(([auteur, items]) => (
                <div>
                  <h3 class="label">{auteur}</h3>
                  <ul class="mt-card divide-y divide-encre/30 border-y border-encre/30">
                    {items.map((r) => <Item r={r} />)}
                  </ul>
                </div>
              ))}
            </div>
          ) : (
            <ul class="divide-y divide-encre/30 border-y border-encre/30 md:col-span-2">
              {c.items.map((r) => <Item r={r} />)}
            </ul>
          )}
        </section>
      ))
    }
  </div>
</BaseLayout>

<script is:inline>
  // Optional filtering: without JS the anchors simply scroll to each section.
  (() => {
    const links = document.querySelectorAll('#filtres [data-filtre]');
    const sections = document.querySelectorAll('[data-categorie]');
    const apply = () => {
      const current = location.hash.slice(1);
      const known = [...sections].some((s) => s.id === current);
      const filtre = known ? current : 'toutes';
      sections.forEach((s) => (s.hidden = filtre !== 'toutes' && s.id !== filtre));
      links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.filtre === filtre)));
    };
    window.addEventListener('hashchange', apply);
    apply();
  })();
</script>
