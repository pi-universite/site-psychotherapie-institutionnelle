---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import APropos from '../components/APropos.astro';
import Partenaires from '../components/Partenaires.astro';
import SitesAmis from '../components/SitesAmis.astro';
import MembresAssocies from '../components/MembresAssocies.astro';
import Agenda from '../components/Agenda.astro';
import { getAccueil, getMembresAssocies, getPartenaires, getSitesAmis } from '../lib/content';

const [hero, aPropos, partenaires, sitesAmis, membresAssocies] = await Promise.all([
  getAccueil('hero'),
  getAccueil('a-propos'),
  getPartenaires(),
  getSitesAmis(),
  getMembresAssocies(),
]);
---
<BaseLayout>
  <Hero titre={hero.titre} sousTitre={hero.sous_titre} />
  <APropos titre={aPropos.titre} texte={aPropos.texte} />
  <Partenaires data={partenaires} />
  <SitesAmis data={sitesAmis} />
  <MembresAssocies data={membresAssocies} />
  <Agenda />
</BaseLayout>
