---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSettings } from '../lib/content';
import '../styles/global.css';
// Fonts are self-hosted through Fontsource (no CDN at runtime).
import '@fontsource-variable/inter';
import '@fontsource/gelasio/400.css';
import '@fontsource/gelasio/400-italic.css';

interface Props {
  title?: string;
  description?: string;
}

const settings = await getSettings();
const { title, description = settings.meta_description } = Astro.props;

const siteName = settings.nom_site;
const fullTitle = title ? `${title} — ${siteName}` : siteName;
// Absolute URLs required by Open Graph, resolved against `site` in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
// Home page only: WebSite structured data, which Google uses to pick the site
// name shown in results. "<" is escaped so CMS text can never close the tag.
const jsonLd =
  Astro.url.pathname === '/'
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteName,
        alternateName: settings.titre_court,
        url: new URL('/', Astro.site).toString(),
        inLanguage: 'fr',
      }).replace(/</g, '\\u003c')
    : null;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Flags JavaScript support before first paint (used by the burger menu). -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <!-- Favicon: ICO for Google and older browsers, SVG for modern ones, PNG for iOS home screens. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <title>{fullTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={siteName} />
    <!-- Social preview: static image built from the hero shapes (public/og.png, 1200x630). -->
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={settings.titre_court} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body class="min-h-screen bg-fond font-sans text-encre antialiased">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:bg-fond focus:p-2">
      Aller au contenu
    </a>
    <div class="relative isolate mx-auto max-w-[1512px] overflow-x-clip px-page">
      <Header title={settings.titre_court} />
      <main id="contenu">
        <slot />
      </main>
      <Footer settings={settings} />
    </div>
  </body>
</html>
