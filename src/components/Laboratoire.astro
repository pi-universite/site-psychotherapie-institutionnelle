---
import type { getPartenaires } from '../lib/content';

interface Props {
  lab: Awaited<ReturnType<typeof getPartenaires>>['laboratoires'][number];
}

const { lab } = Astro.props;
---
<!-- Three blocks (establishment, laboratory, team): the parent decides how they
     line up, e.g. a subgrid so they align across a row of partners. -->
<p class="label">
  {lab.etablissement_url ? (
    <a href={lab.etablissement_url} class="hover:underline" target="_blank" rel="noopener noreferrer">
      {lab.etablissement}
    </a>
  ) : (
    lab.etablissement
  )}
</p>
<div>
  <h3 class="mt-gutter text-subhead whitespace-pre-line">
    {lab.url ? (
      <a href={lab.url} class="hover:underline" target="_blank" rel="noopener noreferrer">
        {lab.laboratoire}
      </a>
    ) : (
      lab.laboratoire
    )}
  </h3>
  {lab.logo && <img src={lab.logo} alt="" class="mt-4 h-10 w-auto" loading="lazy" />}
</div>
<div class="pt-gutter">
  {lab.membres.length > 0 && (
    <>
      {/* The line is kept (empty) without a team label, so members line up across cards. */}
      <p class="label mb-gutter font-normal" aria-hidden={lab.equipe_label ? undefined : 'true'}>
        {lab.equipe_label ? `${lab.equipe_label} :` : ' '}
      </p>
      <ul class="font-serif text-body">
        {lab.membres.map((m) => (
          <li>
            {m.url ? (
              <a href={m.url} class="hover:underline" target="_blank" rel="noopener noreferrer">
                {m.nom}
              </a>
            ) : (
              m.nom
            )}
            {m.bio && (
              <details class="group mt-1 mb-2">
                <summary class="label cursor-pointer font-normal underline underline-offset-2">Présentation</summary>
                <p class="mt-card font-serif text-small">{m.bio}</p>
              </details>
            )}
          </li>
        ))}
      </ul>
    </>
  )}
</div>
