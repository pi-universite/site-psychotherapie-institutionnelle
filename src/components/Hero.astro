---
interface Props {
  titre: string;
  sousTitre?: string;
}

const { titre, sousTitre } = Astro.props;

// Decorative shapes (Miró / Tzara reference), SVGs exported from the Figma
// frame "Desktop - 8" into public/deco/. Each entry reproduces the Figma
// layer: an outer box (left/width in % of the 1512px frame width, top/height
// in % of the top 900px of the frame, header included) holding the unrotated
// SVG, centered and rotated. innerW/innerH are the SVG size in % of the box.
// The box height derives from its width (aspect-ratio), so shapes keep their
// proportions when the layer's own ratio changes on smaller screens.
const shapes = [
  { file: 'tache-bleue', left: -6.81, top: 1.44, width: 22.57, height: 29, rotate: 120.52, innerW: 31.23, innerH: 127.69 },
  { file: 'asterisque', left: 27.25, top: 14.44, width: 5.55, height: 7, rotate: 0, innerW: 100, innerH: 100 },
  { file: 'tache-rouge', left: 57.01, top: 8.88, width: 12.7, height: 16.12, rotate: 0, innerW: 100, innerH: 100 },
  { file: 'zigzag', left: 65.62, top: 13.4, width: 12.08, height: 21.36, rotate: -31.85, innerW: 66.19, innerH: 78.74 },
  { file: 'gribouillis-jaune', left: 87.83, top: 21.44, width: 16.27, height: 21.68, rotate: 0, innerW: 100, innerH: 100 },
  { file: 'gribouillis-vert', left: -10.19, top: 56.76, width: 29.67, height: 46.36, rotate: 57.91, innerW: 58.83, innerH: 87.24 },
  { file: 'coche', left: 11.84, top: 68, width: 15.44, height: 24.32, rotate: -28.93, innerW: 79.25, innerH: 67.62 },
  { file: 'disque-jaune', left: 36.57, top: 65, width: 19.71, height: 31.56, rotate: 0, innerW: 100, innerH: 100 },
  { file: 'anneau-bleu', left: 47.95, top: 53.56, width: 16.92, height: 27.12, rotate: 60.72, innerW: 65.86, innerH: 81.44 },
  { file: 'feuille-verte', left: 81.08, top: 51.88, width: 19.04, height: 36.56, rotate: 37.62, innerW: 37.02, innerH: 101.28 },
  { file: 'trait', left: 77.49, top: 66.92, width: 31.44, height: 22.84, rotate: 20.95, innerW: 104.66, innerH: 14.5 },
];
---
<div
  class="pointer-events-none absolute inset-x-0 top-0 -z-10 aspect-[1512/2600] max-lg:top-28 sm:aspect-[1512/1500] lg:aspect-[1512/900]"
  aria-hidden="true"
>
  {
    shapes.map((s) => (
      <div
        class="absolute flex items-center justify-center"
        style={`left:${s.left}%;top:${s.top}%;width:${s.width}%;aspect-ratio:${s.width * 1512}/${s.height * 900}`}
      >
        <img
          src={`/deco/${s.file}.svg`}
          alt=""
          class="max-w-none flex-none"
          style={`width:${s.innerW}%;height:${s.innerH}%;transform:rotate(${s.rotate}deg)`}
        />
      </div>
    ))
  }
</div>

<section class="relative flex flex-col pt-16 pb-16 sm:min-h-[calc(100vw*1500/1512)] lg:min-h-[calc(100vw*829/1512)] lg:pt-[calc(100vw*168/1512)] xl:min-h-[829px] xl:pt-[168px]">
  <h1 class="max-w-[1098px] text-display font-medium">
    {titre}
  </h1>
  {
    sousTitre && (
      <p class="mt-72 max-w-md text-subhead tracking-normal sm:mt-8 lg:mt-auto lg:mb-[calc(100vw*63/1512)] lg:ml-[59%] xl:mb-[63px]">
        {sousTitre}
      </p>
    )
  }
</section>
