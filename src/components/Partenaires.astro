---
import Section from './Section.astro';
import type { getPartenaires } from '../lib/content';

interface Props {
  data: Awaited<ReturnType<typeof getPartenaires>>;
}

const { titre, laboratoires, soutiens } = Astro.props.data;
---
<Section id="partenaires" titre={titre}>
  <ul class="grid gap-x-3 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      laboratoires.map((lab) => (
        <li class="flex flex-col border-b border-encre/70 pb-6 sm:border-r sm:border-b-encre/70 sm:pr-4">
          <p class="label">{lab.etablissement}</p>
          <h3 class="mt-4 text-xl leading-tight lg:text-[1.35rem]">
            {lab.url ? (
              <a href={lab.url} class="hover:underline" rel="noopener">
                {lab.laboratoire}
              </a>
            ) : (
              lab.laboratoire
            )}
          </h3>
          {lab.logo && <img src={lab.logo} alt="" class="mt-4 h-10 w-auto self-start" loading="lazy" />}
          {lab.membres.length > 0 && (
            <div class="mt-auto pt-6">
              {lab.equipe_label && <p class="label font-normal">{lab.equipe_label} :</p>}
              <ul class="mt-3 font-serif text-sm leading-snug">
                {lab.membres.map((m) => (
                  <li>
                    {m.url ? (
                      <a href={m.url} class="hover:underline" rel="noopener">
                        {m.nom}
                      </a>
                    ) : (
                      m.nom
                    )}
                    {m.bio && (
                      <details class="group mt-1 mb-2">
                        <summary class="label cursor-pointer font-normal underline underline-offset-2">Présentation</summary>
                        <p class="mt-2 text-xs leading-snug">{m.bio}</p>
                      </details>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </li>
      ))
    }
  </ul>

  {
    soutiens.length > 0 && (
      <div class="mt-12">
        <p class="label">Avec le soutien de</p>
        <ul class="mt-4 flex flex-wrap items-center gap-8">
          {soutiens.map((s) => {
            const content = s.logo ? <img src={s.logo} alt={s.nom} class="h-12 w-auto" loading="lazy" /> : s.nom;
            return <li>{s.url ? <a href={s.url} rel="noopener">{content}</a> : content}</li>;
          })}
        </ul>
      </div>
    )
  }
</Section>
