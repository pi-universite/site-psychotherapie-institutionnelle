---
import Section from './Section.astro';
import Laboratoire from './Laboratoire.astro';
import type { getPartenaires } from '../lib/content';

interface Props {
  data: Awaited<ReturnType<typeof getPartenaires>>;
}

const { titre, laboratoires, soutiens } = Astro.props.data;

// Figma: a vertical rule in the middle of the 20px gap before every column but
// the first, and a bottom rule under every row but the last. Column count
// changes with the breakpoint (1 / 2 at sm / 3 at lg), so classes are computed
// per item for each grid.
const n = laboratoires.length;
const lastRowStart = (cols: number) => Math.floor((n - 1) / cols) * cols;
function cellClasses(i: number) {
  return [
    i === n - 1 ? 'border-b-0' : 'border-b',
    i % 2 ? 'sm:-ml-card sm:border-l sm:pl-card' : 'sm:ml-0 sm:border-l-0 sm:pl-0',
    i >= lastRowStart(2) ? 'sm:border-b-0' : 'sm:border-b',
    i % 3 ? 'lg:-ml-card lg:border-l lg:pl-card' : 'lg:ml-0 lg:border-l-0 lg:pl-0',
    i >= lastRowStart(3) ? 'lg:border-b-0' : 'lg:border-b',
  ];
}
---
<Section id="partenaires" titre={titre}>
  <ul class="grid gap-gutter sm:grid-cols-2 lg:grid-cols-3">
    {
      laboratoires.map((lab, i) => (
        // Subgrid: establishment, laboratory and team blocks line up across a row.
        <li class:list={['row-span-3 grid grid-rows-subgrid gap-y-0 border-encre pb-gutter', cellClasses(i)]}>
          <Laboratoire lab={lab} />
        </li>
      ))
    }
  </ul>

  {
    soutiens.length > 0 && (
      <div class="mt-12">
        <p class="label">Avec le soutien de</p>
        <ul class="mt-4 flex flex-wrap items-center gap-8">
          {soutiens.map((s) => {
            const content = s.logo ? <img src={s.logo} alt={s.nom} class="h-12 w-auto" loading="lazy" /> : s.nom;
            return <li>{s.url ? <a href={s.url} rel="noopener">{content}</a> : content}</li>;
          })}
        </ul>
      </div>
    )
  }
</Section>
