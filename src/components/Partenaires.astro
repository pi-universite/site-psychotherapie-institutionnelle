---
import Section from './Section.astro';
import Laboratoire from './Laboratoire.astro';
import type { getPartenaires } from '../lib/content';

interface Props {
  data: Awaited<ReturnType<typeof getPartenaires>>;
}

const { titre, laboratoires } = Astro.props.data;

// Figma: a vertical rule in the middle of the gap before every column but the
// first, stopping above the row's bottom rules; a bottom rule (column wide, so
// rules never meet) under every row but the last. Column count changes with
// the breakpoint (1 / 2 at sm / 3 at lg), so classes are computed per item.
// When the last row is incomplete, the last card also gets a rule on its right,
// in front of the empty cells.
const n = laboratoires.length;
const lastRowStart = (cols: number) => Math.floor((n - 1) / cols) * cols;
function cellClasses(i: number) {
  return [
    i === n - 1 ? 'border-b-0' : 'border-b',
    i % 2 ? 'sm:before:block' : 'sm:before:hidden',
    i >= lastRowStart(2) ? 'sm:border-b-0' : 'sm:border-b',
    i % 3 ? 'lg:before:block' : 'lg:before:hidden',
    i >= lastRowStart(3) ? 'lg:border-b-0' : 'lg:border-b',
    i === n - 1 && i % 2 !== 1 ? 'sm:after:block' : 'sm:after:hidden',
    i === n - 1 && i % 3 !== 2 ? 'lg:after:block' : 'lg:after:hidden',
  ];
}
---
<Section id="partenaires" titre={titre}>
  <ul class="grid gap-gutter sm:grid-cols-2 lg:grid-cols-3">
    {
      laboratoires.map((lab, i) => (
        // Subgrid: establishment, laboratory and team blocks line up across a row.
        <li class:list={['relative row-span-3 grid grid-rows-subgrid gap-y-0 border-encre pb-gutter before:absolute before:top-0 before:bottom-gutter before:-left-card before:hidden before:w-px before:bg-encre after:absolute after:top-0 after:bottom-gutter after:-right-card after:hidden after:w-px after:bg-encre', cellClasses(i)]}>
          <Laboratoire lab={lab} />
        </li>
      ))
    }
  </ul>
</Section>
