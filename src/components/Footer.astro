---
import type { getSettings } from '../lib/content';

interface Props {
  settings: Awaited<ReturnType<typeof getSettings>>;
}

const { settings } = Astro.props;
---
<footer id="contacts" class="grid gap-8 border-t border-encre py-12 md:grid-cols-4 md:items-start md:gap-5 lg:pt-[60px] lg:pb-[53px]">
  <h2 class="text-4xl tracking-[-0.05em] md:text-5xl lg:text-[60px]">Contacts</h2>
  {settings.adresse && <p class="label whitespace-pre-line font-medium lg:mt-6">{settings.adresse}</p>}
  <p class="label font-medium lg:mt-6">
    {settings.email && <a href={`mailto:${settings.email}`} class="hover:underline">{settings.email}</a>}
    {settings.email && settings.telephone && <br />}
    {settings.telephone && <a href={`tel:${settings.telephone.replace(/[^+\d]/g, '')}`} class="hover:underline">{settings.telephone}</a>}
  </p>
  {
    settings.newsletter_url && (
      <p class="label font-medium lg:mt-6">
        Newsletter
        <br />
        <a href={settings.newsletter_url} class="font-semibold underline underline-offset-2" rel="noopener">
          {settings.newsletter_label}
        </a>
      </p>
    )
  }
</footer>
