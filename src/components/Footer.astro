---
import type { getSettings } from '../lib/content';

interface Props {
  settings: Awaited<ReturnType<typeof getSettings>>;
}

const { settings } = Astro.props;
---
<!-- From md: every block sits on the last baseline of "Contacts" (Figma). -->
<footer id="contacts" class="grid gap-gutter border-t border-encre py-section md:grid-cols-4 md:items-baseline-last md:gap-y-0">
  <h2 class="text-title">Contacts</h2>
  {settings.adresse && <p class="label whitespace-pre-line font-medium">{settings.adresse}</p>}
  <p class="label font-medium">
    {settings.email && <a href={`mailto:${settings.email}`} class="hover:underline">{settings.email}</a>}
    {settings.email && settings.telephone && <br />}
    {settings.telephone && <a href={`tel:${settings.telephone.replace(/[^+\d]/g, '')}`} class="hover:underline">{settings.telephone}</a>}
  </p>
  {
    settings.newsletter_url && (
      <p class="label font-medium">
        Newsletter
        <br />
        <a href={settings.newsletter_url} class="font-semibold underline underline-offset-2" target="_blank" rel="noopener noreferrer">
          {settings.newsletter_label}
        </a>
      </p>
    )
  }
  <!-- Desktop: second row, right under "Contacts" (kept out of the baseline
       row so it doesn't shift the blocks above), indented by the side bearing
       of the large "C" (~5% of the title size) so both left edges line up.
       Phones: last. -->
  <p class="text-note md:col-start-1 md:row-start-2 md:pl-[calc(var(--text-title)*0.05)]">
    <a href="/mentions-legales/" class="underline underline-offset-2">Mentions légales et confidentialité</a>
  </p>
</footer>
