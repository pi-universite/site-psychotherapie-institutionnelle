---
import { AGENDA_TYPE_META, lastDay, type Evenement } from '../lib/content';
import { formatDateRange, isoDay } from '../lib/dates';

interface Props {
  event: Evenement;
  past: boolean;
}

const { event, past } = Astro.props;
const e = event.data;
const meta = AGENDA_TYPE_META[e.type];
const dates = formatDateRange(e.date_debut, e.date_fin);
// Calls for papers have no venue: the mockup shows them with a large title.
const isCall = e.type === 'appel';
---
<li
  class:list={['agenda-card flex min-h-[416px] flex-col px-[11px] py-[9px]', meta.bg]}
  data-debut={isoDay(e.date_debut)}
  data-fin={lastDay(event)}
  data-past={past ? '' : undefined}
>
  {
    isCall ? (
      <h3 class="text-[40px] leading-[45px] font-medium tracking-[-0.04em]">{e.titre}</h3>
    ) : (
      <>
        <p class="border-b border-encre pb-2 text-[15px]">
          <time datetime={isoDay(e.date_debut)}>{dates}</time>
          {e.horaire && <> : {e.horaire}</>}
        </p>
        {e.lieu && <p class="border-b border-encre py-2 text-[15px] uppercase">{e.lieu}</p>}
        <h3 class="mt-2 text-[25px] leading-[30px] font-semibold tracking-[-0.04em]">{e.titre}</h3>
      </>
    )
  }
  {e.description && <p class="mt-3 font-serif text-[15px] leading-snug">{e.description}</p>}
  {
    isCall && (
      <p class="mt-3 text-[15px]">
        Date limite : <time datetime={isoDay(e.date_debut)}>{dates}</time>
      </p>
    )
  }
  <p class="mt-auto flex items-baseline justify-between gap-4 border-t border-encre pt-2">
    <span class="label">{meta.label}</span>
    {
      e.lien && (
        <a href={e.lien} class="text-[15px] uppercase tracking-[-0.04em] underline underline-offset-2" rel="noopener">
          {e.lien_label || 'Site web'}
        </a>
      )
    }
  </p>
</li>
