---
import Section from './Section.astro';
import { renderMarkdown } from '../lib/markdown';

interface Props {
  titre: string;
  texte?: string;
}

const { titre, texte } = Astro.props;
const html = await renderMarkdown(texte);
---
<Section id="a-propos" titre={titre} layout="side">
  <div class="max-w-[802px] font-serif text-base leading-snug lg:mt-[13px] lg:text-[19px] lg:leading-6 [&_a]:underline [&_p+p]:mt-0" set:html={html} />
</Section>
