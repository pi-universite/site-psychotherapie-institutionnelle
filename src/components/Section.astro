---
interface Props {
  id: string;
  titre: string;
  // "side": heading in a left column (À propos); "top": heading above.
  layout?: 'side' | 'top';
}

const { id, titre, layout = 'top' } = Astro.props;
---
<section
  id={id}
  aria-labelledby={`${id}-titre`}
  class:list={[
    'border-t border-encre py-section',
    // Side layout: title in the first column of the 3-column grid, content in the other two.
    layout === 'side' && 'md:grid md:grid-cols-3 md:gap-x-gutter',
  ]}
>
  <h2 id={`${id}-titre`} class="mb-section text-title">{titre}</h2>
  <div class:list={[layout === 'side' && 'md:col-span-2']}>
    <slot />
  </div>
</section>
