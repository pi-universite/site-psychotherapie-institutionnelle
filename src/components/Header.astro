---
interface Props {
  title: string;
}

const { title } = Astro.props;
const onHome = Astro.url.pathname === '/';
// Section links must work from /ressources/ too, hence the leading "/".
const links = [
  { href: '/#a-propos', label: 'À propos' },
  { href: '/#partenaires', label: 'Partenaires' },
  { href: '/#agenda', label: 'Agenda' },
  { href: '/ressources/', label: 'Ressources' },
  { href: '#contacts', label: 'Contacts' },
];
---
<header class="relative z-10 flex flex-col gap-4 border-b border-encre py-gutter lg:flex-row lg:items-center lg:justify-between lg:py-7">
  <a href="/" class="max-w-md text-small font-bold" aria-current={onHome ? 'page' : undefined}>
    {title}
  </a>
  <nav aria-label="Navigation principale">
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-nav md:gap-x-14">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="underline-offset-4 hover:underline"
              aria-current={link.href === Astro.url.pathname ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
