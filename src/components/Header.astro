---
interface Props {
  title: string;
}

const { title } = Astro.props;
const onHome = Astro.url.pathname === '/';
// Section links must work from /ressources/ too, hence the leading "/".
const links = [
  { href: '/#a-propos', label: 'À propos' },
  { href: '/#partenaires', label: 'Partenaires' },
  { href: '/#agenda', label: 'Agenda' },
  { href: '/ressources/', label: 'Ressources' },
  { href: '#contacts', label: 'Contacts' },
];
---
<header class="relative z-10 flex flex-col gap-4 border-b border-encre py-5 lg:h-[92px] lg:flex-row lg:items-start lg:justify-between lg:py-0 lg:pt-[26px]">
  <a href="/" class="max-w-[445px] text-sm leading-tight font-bold lg:text-[15px]" aria-current={onHome ? 'page' : undefined}>
    {title}
  </a>
  <nav aria-label="Navigation principale" class="lg:pt-[14px]">
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-base md:gap-x-14 lg:text-xl">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="underline-offset-4 hover:underline"
              aria-current={link.href === Astro.url.pathname ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
